{
  "name": "strike-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Dark-first design tokens and Vue 3 components for dense operator dashboards",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/style.css"
  },
  "scripts": {
    "dev": "histoire dev",
    "story": "histoire dev",
    "story:build": "histoire build",
    "story:preview": "histoire preview",
    "build": "rm -rf dist && vue-tsc -p tsconfig.build.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .vue,.ts,.js",
    "typecheck": "vue-tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "^0.17.17",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.32.0",
    "histoire": "^0.17.17",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "packageManager": "pnpm@10.18.3",
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "design-system",
    "dark-theme",
    "dashboard",
    "typescript"
  ]
}
